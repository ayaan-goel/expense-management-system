{
  "name": "expense-tracker-backend",
  "version": "1.0.0",
  "description": "Expense Management System Backend with Approval Workflows",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initDatabase.js",
    "seed": "node scripts/seedData.js",
    "setup": "npm run init-db && npm run seed",
    "reset": "rm -f database.sqlite && npm run setup",
    "team-setup": "node setup-team.js"
  },
  "dependencies": {
    "axios": "^1.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-fileupload": "^1.4.0",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.32.4",
    "sqlite3": "^5.1.6",
    "tesseract.js": "^4.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "expense",
    "management",
    "approval",
    "workflow",
    "ocr",
    "express",
    "sqlite"
  ],
  "author": "Ayaan Goel",
  "license": "MIT"
}
