# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend Configuration (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Keys
EXCHANGE_API_KEY=your-exchange-rate-api-key-optional
RESTCOUNTRIES_URL=https://restcountries.com/v3.1/all?fields=name,currencies

# Exchange Rate API Configuration
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/

# File Upload Configuration
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/gif,application/pdf

# Database Configuration (SQLite - no additional config needed)
# The database file will be created automatically as 'expense_tracker.db'

# OCR Configuration
OCR_CONFIDENCE_THRESHOLD=60

# Cleanup Configuration
TEMP_FILE_CLEANUP_HOURS=1
OCR_FILE_RETENTION_DAYS=30
EXCHANGE_RATE_CACHE_HOURS=1